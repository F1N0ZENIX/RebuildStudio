<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>RebuildStudio.App</RootNamespace>
    <AssemblyName>RebuildStudioAI</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\RebuildStudio.Core\RebuildStudio.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\..\samples\DemoApp\**\*.*"
             Exclude="..\..\samples\DemoApp\bin\**;..\..\samples\DemoApp\obj\**"
             Link="samples\DemoApp\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
