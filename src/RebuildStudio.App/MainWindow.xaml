<Window x:Class="RebuildStudio.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rebuild Studio" Width="1380" Height="900" MinWidth="1080" MinHeight="720"
        Background="{StaticResource Bg}" WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <Style x:Key="SectionTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="16"/><Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Margin" Value="0,0,0,12"/>
    </Style>
    <Style x:Key="Hint" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Muted}"/><Setter Property="FontSize" Value="12"/>
    </Style>
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource Panel}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
      <Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Padding" Value="18"/>
    </Style>
    <Style TargetType="PasswordBox">
      <Setter Property="Background" Value="{StaticResource Bg}"/><Setter Property="Foreground" Value="{StaticResource Fg}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Line}"/><Setter Property="Padding" Value="9"/>
    </Style>
  </Window.Resources>
  <Grid Margin="22">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="170"/></Grid.RowDefinitions>
    <Grid Grid.Row="0" Margin="0,0,0,18">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal">
        <Border Width="42" Height="42" Background="{StaticResource Accent}" CornerRadius="12" Margin="0,0,13,0">
          <TextBlock Text="R" FontSize="25" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White"/>
        </Border>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="REBUILD STUDIO" FontSize="22" FontWeight="Bold" LetterSpacing="1"/>
          <TextBlock Text="Análise • engenharia reversa • laboratório de modificações" Style="{StaticResource Hint}" Margin="0,3,0,0"/>
        </StackPanel>
      </StackPanel>
      <Border Grid.Column="1" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="20" Padding="13,8" VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal">
          <Ellipse Width="8" Height="8" Fill="{StaticResource Accent}" Margin="0,0,8,0" VerticalAlignment="Center"/>
          <TextBlock Text="{Binding StateText}" FontWeight="SemiBold" VerticalAlignment="Center"/>
        </StackPanel>
      </Border>
    </Grid>
    <Border Grid.Row="1" Background="#211D35" BorderBrush="#40336B" BorderThickness="1" CornerRadius="10" Padding="13" Margin="0,0,0,16">
      <TextBlock Text="O original nunca é alterado. A análise é estática; recompilação depende do formato e da disponibilidade do código-fonte/projeto." Foreground="#D9D1FF" TextWrapping="Wrap"/>
    </Border>
    <Grid Grid.Row="2" Margin="0,0,0,16">
      <Grid.ColumnDefinitions><ColumnDefinition Width="0.92*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="1.08*"/></Grid.ColumnDefinitions>
      <Grid Grid.Column="0">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="170"/></Grid.RowDefinitions>
        <Border Style="{StaticResource Card}" Margin="0,0,0,14">
          <StackPanel>
            <TextBlock Text="01  /  ANALISAR EXECUTÁVEL" Style="{StaticResource SectionTitle}"/>
            <TextBlock Text="Escolha um arquivo para identificar arquitetura, formato, seções e possibilidades de análise." Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,0,0,14"/>
            <WrapPanel>
              <Button Content="Selecionar EXE…" Command="{Binding SelectExeCommand}"/>
              <Button Content="Analisar arquivo" Command="{Binding AnalyzeCommand}"/>
              <Button Content="Descompilar .NET" Command="{Binding DecompileCommand}" Background="#343044"/>
            </WrapPanel>
            <Border Background="{StaticResource Bg}" CornerRadius="7" Padding="10" Margin="0,5,0,0">
              <TextBlock Text="{Binding SelectedPath}" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" ToolTip="{Binding SelectedPath}"/>
            </Border>
            <TextBlock Text="{Binding FeasibilityText}" Foreground="{Binding FeasibilityBrush}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,12,0,0"/>
          </StackPanel>
        </Border>
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,14">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <TextBlock Text="RELATÓRIO DE ANÁLISE" Style="{StaticResource SectionTitle}"/>
            <TextBox Grid.Row="1" Text="{Binding ReportText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Cascadia Mono" BorderThickness="0" Padding="10"/>
          </Grid>
        </Border>
        <Border Grid.Row="2" Style="{StaticResource Card}">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <TextBlock Text="WORKSPACES RECENTES" Style="{StaticResource SectionTitle}"/>
            <ListBox Grid.Row="1" ItemsSource="{Binding History}" BorderThickness="0"/>
          </Grid>
        </Border>
      </Grid>
      <Border Grid.Column="2" Style="{StaticResource Card}">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <StackPanel>
            <TextBlock Text="02  /  LABORATÓRIO DE MODIFICAÇÃO" Style="{StaticResource SectionTitle}"/>
            <TextBlock Text="Teste o fluxo completo em um projeto .NET de demonstração. A IA propõe patches de texto; você revisa antes de aplicar." Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,0,0,14"/>
          </StackPanel>
          <Border Grid.Row="1" Background="{StaticResource Bg}" CornerRadius="8" Padding="12" Margin="0,0,0,14">
            <StackPanel>
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="Modelo OpenRouter" VerticalAlignment="Center" Margin="0,0,12,0" FontWeight="SemiBold"/>
                <TextBox Grid.Column="1" Text="{Binding ModelName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,10,0"/>
                <CheckBox Grid.Column="2" Content="Usar IA" IsChecked="{Binding UseAi}" IsEnabled="{Binding HasApiKey}" VerticalAlignment="Center"/>
              </Grid>
              <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <PasswordBox x:Name="KeyBox" Width="220"/>
                <Button Content="Salvar chave" Click="SaveKey_Click" Margin="8,0,0,0"/>
                <Button Content="Remover" Click="RemoveKey_Click" Background="#343044" Margin="8,0,0,0"/>
              </StackPanel>
              <TextBlock Text="{Binding ApiKeyStatus}" Style="{StaticResource Hint}" Margin="0,7,0,0"/>
            </StackPanel>
          </Border>
          <StackPanel Grid.Row="2" Margin="0,0,0,14">
            <TextBlock Text="O QUE VOCÊ QUER MODIFICAR?" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Muted}" Margin="0,0,0,7"/>
            <TextBox Text="{Binding RequestText, UpdateSourceTrigger=PropertyChanged}" Height="88" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Padding="11"/>
          </StackPanel>
          <StackPanel Grid.Row="3" Margin="0,0,0,14">
            <TextBlock Text="ETAPAS DO WORKFLOW" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Muted}" Margin="0,0,0,8"/>
            <WrapPanel>
              <Button Content="1  Preparar" Command="{Binding PrepareDemoCommand}"/>
              <Button Content="2  Planejar" Command="{Binding PlanCommand}"/>
              <Button Content="3  Aplicar" Command="{Binding ApplyCommand}"/>
              <Button Content="4  Compilar e validar" Command="{Binding BuildCommand}"/>
              <Button Content="5  Exportar" Command="{Binding ExportCommand}"/>
              <Button Content="Restaurar" Command="{Binding RestoreCommand}" Background="#343044"/>
            </WrapPanel>
          </StackPanel>
          <Grid Grid.Row="4">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <TextBlock Text="PLANO / DIFF PARA REVISÃO" Style="{StaticResource SectionTitle}"/>
            <TextBox Grid.Row="1" Text="{Binding PlanText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Cascadia Mono" Padding="11"/>
          </Grid>
        </Grid>
      </Border>
    </Grid>
    <Border Grid.Row="3" Style="{StaticResource Card}" Padding="14">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,8">
          <TextBlock Text="LOG DE ATIVIDADE" FontWeight="SemiBold" FontSize="12"/>
          <TextBlock DockPanel.Dock="Right" Text="Diagnóstico e erros" Style="{StaticResource Hint}"/>
        </DockPanel>
        <TextBox x:Name="LogBox" Grid.Row="1" Text="{Binding LogText, Mode=OneWay}" IsReadOnly="True" FontFamily="Cascadia Mono" FontSize="11" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" BorderThickness="0" Padding="8" TextChanged="LogBox_TextChanged"/>
      </Grid>
    </Border>
  </Grid>
</Window>
